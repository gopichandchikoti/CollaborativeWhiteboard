{
  "name": "collaborative-whiteboard-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --project tsconfig.test.json",
    "lint": "eslint src tests",
    "format:check": "prettier --check src tests public",
    "format": "prettier --write src tests public",
    "benchmark": "vitest run --config vitest.benchmark.config.ts"
  },
  "dependencies": {
    "lucide-react": "^1.68.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yjs": "13.6.33",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "fake-indexeddb": "^6.2.7",
    "jscpd": "^4.0.5",
    "jsdom": "^24.1.3",
    "prettier": "^3.6.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.46.0",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
